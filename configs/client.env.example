# Copy this to  client.local.env  (gitignored) and fill in your real values.
# Then run:  ./scripts/make-client-links.sh
# It prints share links + QR codes you import into Hiddify (one tap = On/Off).
#
# DO NOT commit client.local.env — it contains secrets.

NAME_PREFIX="MyVPN"

# --- Reality (PRIMARY: direct to VPS, grey cloud / raw IP) ---
REALITY_ENABLE=1
REALITY_SERVER="1.2.3.4"            # VPS public IP, or a grey-cloud DNS name
REALITY_PORT=443
REALITY_UUID=""                    # xray uuid
REALITY_SNI="www.example-site.com" # the borrowed SNI (your serverNames/dest host)
REALITY_PUBKEY=""                  # server PUBLIC key from `xray x25519`
REALITY_SHORTID=""                 # one of your shortIds

# --- VLESS + WS + TLS behind Cloudflare (SECONDARY) ---
WS_ENABLE=1
WS_HOST="your.domain.example"      # Cloudflare-fronted hostname (orange cloud)
WS_PORT=443
WS_UUID=""
WS_PATH="/your-secret-path"

# --- Hysteria2 (FAST LANE) ---
HY2_ENABLE=1
HY2_HOST="your.domain.example"
HY2_PORT=443
HY2_PASSWORD=""
HY2_MPORT=""                       # optional port-hopping range, e.g. 20000-50000
